# VPS: bu dosyayı sunucuda server/.env olarak kopyala ve düzenle
# API domain: https://api.mollayazilim.com

PORT=3002
# VPS (Nginx arkaya): repo-paths.cmd icinde API_PORT=3000 yapabilirsiniz
NODE_ENV=production

MIN_REQUIRED_VERSION=0.1.0
LATEST_VERSION=0.1.0
FORCE_UPDATE=true
UPDATE_URL_ANDROID=https://github.com/afmolla/vampir-koylu/releases/latest

# openssl rand -hex 32
JWT_SECRET=BURAYA_UZUN_RASTGELE_ANAHTAR
JWT_EXPIRES_IN=7d

# Docker Compose içinde host adı "postgres"
DATABASE_URL=postgresql://vampir:POSTGRES_SIFREN@postgres:5432/vampir_koylu

GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

PORT=3000
NODE_ENV=development

# Version gate (semver) — clients below min cannot play
MIN_REQUIRED_VERSION=0.1.0
LATEST_VERSION=0.1.0
FORCE_UPDATE=true
UPDATE_URL_ANDROID=https://github.com/afmolla/flutter/releases/latest

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Database (optional for MVP — in-memory until Postgres wired)
DATABASE_URL=postgresql://vampir:vampir@localhost:5432/vampir_koylu

# OAuth (configure when enabling social login)
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

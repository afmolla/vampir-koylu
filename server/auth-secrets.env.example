# Google / Facebook OAuth — bu dosyayi kopyala: auth-secrets.env
# BASLAT-API.cmd her baslatmada .env ile birlestirir (SILINMEZ).

# Google Cloud Console > APIs & Services > Credentials
# 1) "Web application" OAuth 2.0 Client ID (ZORUNLU — mobil serverClientId + sunucu)
GOOGLE_CLIENT_ID=123456789012-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
#
# 2) Isteg bagli: "Android" OAuth client (SHA-1 imza parmak izi Play Console / keytool ile)
# GOOGLE_ANDROID_CLIENT_ID=123456789012-yyyyyyyyyyyyyyyyyyyyyyyyyyyy.apps.googleusercontent.com
#
# GitHub Actions: GOOGLE_SERVER_CLIENT_ID secret = ayni Web Client ID
# APK test: https://SUNUCU:3002/api/config/public -> googleSignInEnabled: true

# Facebook (istege bagli)
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
